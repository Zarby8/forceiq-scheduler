# Google Calendar API Configuration
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
GOOGLE_SHEET_ID=your-google-sheet-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=scheduler@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"

# Scheduling Configuration
TIMEZONE=America/Detroit
SLOT_MINUTES=60
BUFFER_MINUTES=15

# Security
HMAC_SECRET=your-hmac-secret-key-here

# Email Configuration (optional - for notifications)
OWNER_EMAILS=chris@forcehockeyiq.com,shaneb@forcehockeyiq.com

# Working Hours (JSON format)
# Format: {"1": [["10:00", "14:00"]], "2": [["17:00", "20:00"]], ...}
# 0=Sunday, 1=Monday, 2=Tuesday, 3=Wednesday, 4=Thursday, 5=Friday, 6=Saturday
WORKING_HOURS={"1":[["10:00","14:00"]],"2":[["17:00","20:00"]],"3":[["17:00","20:00"]],"4":[["17:00","20:00"]],"5":[["10:00","13:00"]],"6":[],"0":[]}