// Shared.xcconfig
// Minimal shared configuration for scaffold tool customization
// All other settings use Xcode project defaults
// Generated by XcodeBuildMCP

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = ForceIQScheduler
PRODUCT_DISPLAY_NAME = ForceIQ Scheduler
PRODUCT_BUNDLE_IDENTIFIER = com.forceiq.scheduler
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

// ==========================================
// Platform Configuration
// ==========================================
MACOSX_DEPLOYMENT_TARGET = 14.0

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_NSAppleEventsUsageDescription = Used to send weekly scheduling messages via Messages.

// ==========================================
// Code Signing & Distribution
// ==========================================
// AI agents can modify Config/ForceIQScheduler.entitlements to add capabilities
CODE_SIGN_ENTITLEMENTS = Config/ForceIQScheduler.entitlements
CODE_SIGN_STYLE = Manual
DEVELOPMENT_TEAM = 8PFL93TJ88
CODE_SIGN_IDENTITY = Apple Development: Christopher Robert Zarb (C36SQ5A845)
PROVISIONING_PROFILE_SPECIFIER =

// Notarization settings
ENABLE_HARDENED_RUNTIME = YES
OTHER_CODE_SIGN_FLAGS = --timestamp

// ==========================================
// Swift Settings
// ==========================================
SWIFT_STRICT_CONCURRENCY = minimal

// ==========================================
// Build Settings
// ==========================================
ALWAYS_SEARCH_USER_PATHS = NO
USE_HEADERMAP = NO

// ==========================================
// AppIntents Settings
// ==========================================
// Disable AppIntents metadata processing since we don't use AppIntents
GENERATE_APPINTENTS_METADATA = NO