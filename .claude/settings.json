{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh scripts/beacon/hook.sh --harness claude --event session-start || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh scripts/beacon/hook.sh --harness claude --event prompt-submit || true",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh scripts/beacon/hook.sh --harness claude --event post-tool || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh scripts/beacon/hook.sh --harness claude --event stop || true",
            "timeout": 45
          }
        ]
      }
    ]
  }
}
